LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
MLOL_WEBSITE="https://bibliotu.medialibrary.it"

TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_CHANNEL=your_channel_username

MLOL_USERNAME=""
MLOL_PASSWORD=""

# Optional: notify the admin about major errors via a Telegram bot.
# Enabled only when both TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional: forum topic (message thread) id to post into.
TELEGRAM_THREAD_ID=""
# Suppress repeats of the same alert for this many seconds (default 1800).
NOTIFY_COOLDOWN=1800

# ignore publications older than this date (YYYYMMDD)
THRESHOLD_DATE=20251214
DELETE_AFTER_DONE=False
SCHEDULER_TIME=05:00
MIN_SCALE=50
SCALE_STEP=5
MAX_RETRIES=10
CHROMIUM_TIMEOUT=5000
REQUEST_TIMEOUT=30
HEARTBEAT_TIMEOUT=600
# After this many consecutive identical JWT/login failures, pause retries and
# notify the admin that manual intervention is needed.
JWT_MAX_FAILURES=3
JWT_FAILURE_COOLDOWN=1800
